#### الخطوة 3: كود السيرفر الكامل `server.py`

```python
import io
import os
import numpy as np
from fastapi import FastAPI, UploadFile, File, HTTPException
from fastapi.responses import JSONResponse
from PIL import Image
import uvicorn

# ==========================================
# تحميل نموذج الذكاء الاصطناعي عند بدء السيرفر
# ==========================================
import tensorflow as tf

MODEL_PATH = '/home/pi/shawan_server/model/dr_model.h5'
IMG_SIZE = (224, 224)  # حجم الصورة الذي يتوقعه النموذج — عدّله حسب نموذجك

# أسماء المراحل الخمسة بالترتيب (0 → 4)
CLASS_NAMES = ['No DR', 'Mild', 'Moderate', 'Severe', 'Proliferative']

print("Loading AI model...")
model = tf.keras.models.load_model(MODEL_PATH)
print("✅ Model loaded successfully!")

# ==========================================
# إنشاء السيرفر
# ==========================================
app = FastAPI(
    title="DR-Check AI Server",
    description="Diabetic Retinopathy Detection API",
    version="1.0.0"
)

def preprocess_image(image_bytes: bytes) -> np.ndarray:
    """تحويل الصورة المستقبلة إلى tensor جاهز للنموذج"""
    image = Image.open(io.BytesIO(image_bytes)).convert('RGB')
    image = image.resize(IMG_SIZE)
    image_array = np.array(image, dtype=np.float32)
    image_array = image_array / 255.0          # Normalize
    image_array = np.expand_dims(image_array, axis=0)  # إضافة batch dimension
    return image_array


@app.get("/health")
async def health_check():
    """نقطة فحص — الجوال يستخدمها للتأكد من أن السيرفر شغال"""
    return {
        "status": "online",
        "device": "Raspberry Pi",
        "model": "DR-Check v1.0"
    }


@app.post("/predict")
async def predict(image: UploadFile = File(...)):
    """استقبال صورة العين وإرجاع نتيجة التشخيص"""
    try:
        # 1. قراءة ملف الصورة
        image_bytes = await image.read()

        if len(image_bytes) == 0:
            raise HTTPException(status_code=400, detail="Empty image file")

        # 2. معالجة الصورة
        processed = preprocess_image(image_bytes)

        # 3. تشغيل النموذج
        predictions = model.predict(processed)
        stage = int(np.argmax(predictions[0]))       # المرحلة (0-4)
        confidence = float(np.max(predictions[0]) * 100)  # نسبة الثقة
        result_label = CLASS_NAMES[stage]

        # 4. إرجاع النتيجة للجوال
        return JSONResponse(content={
            "status": "completed",
            "resultLabel": result_label,
            "stage": stage,
            "confidence": round(confidence, 1)
        })

    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Prediction error: {str(e)}")


if __name__ == "__main__":
    print("Starting DR-Check AI Server on port 8000...")
    uvicorn.run(
        app,
        host="0.0.0.0",  # يسمح بالاتصال من أي جهاز على الشبكة
        port=8000,
        log_level="info"
    )
```

